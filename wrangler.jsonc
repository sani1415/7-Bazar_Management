{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bazar-management",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-24",
  "assets": {
    "directory": "app",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/images/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bazar-management",
      "database_id": "ffdb32b4-1efb-4d43-a074-85e24d4e0f77",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "bazar-management-images"
    }
  ]
}
